# Supabase Connection Settings
# Retrieve these from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Supabase service role key (for administrative server scripts/cron jobs only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_APP_NAME="NFL Weekly Pool"
NEXT_PUBLIC_SEASON_YEAR=2026
